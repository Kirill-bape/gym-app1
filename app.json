{
  "expo": {
    "name": "Форма",
    "slug": "forma-gym",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kirillbape.forma"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kirillbape.forma"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0E0F12",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Разреши доступ к фото, чтобы посчитать калории по снимку еды",
          "cameraPermission": "Разреши доступ к камере, чтобы сфотографировать еду и посчитать калории",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
